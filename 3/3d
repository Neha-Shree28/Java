import java.awt.*;
import java.awt.event.*;

public class ButtonCounter extends Frame implements ActionListener {
    Button button;
    Label label;
    int count = 0;
    ButtonCounter() {
        button = new Button("Click Me");
        label = new Label("Count: 0");
        button.setBounds(100, 80, 100, 40);
        label.setBounds(100, 140, 100, 30);
        add(button);
        add(label);
        button.addActionListener(this);
        setSize(300, 250);
        setLayout(null);
        setVisible(true);
    }
    public void actionPerformed(ActionEvent e) {
        count++;
        label.setText("Count: " + count);
    }
    public static void main(String[] args) {
        new ButtonCounter();
    }
}


